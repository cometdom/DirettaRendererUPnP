 	}
 
 	/* Grab the current Rx skb from the ring and DMA-unmap it */
 	rx_skb = bcmgenet_free_rx_cb(kdev, cb);
 
-	/* Put the new Rx skb on the ring */
+	/* Put the new Rx skb on the ring. Clear the length/status word so
+	 * that bcmgenet_desc_rx() can tell a descriptor the DMA has finished
+	 * with from one it has only been handed early (see there).
+	 */
 	cb->skb = skb;
 	dma_unmap_addr_set(cb, dma_addr, mapping);
 	dma_unmap_len_set(cb, dma_len, priv->rx_buf_len);
 	dmadesc_set_addr(priv, cb->bd_addr, mapping);
+	dmadesc_set_length_status(priv, cb->bd_addr, 0);
 
 	/* Return the current Rx skb to caller */
 	return rx_skb;
 }
 
+/* Maximum number of Rx descriptors a single frame may span: a 9216 byte
+ * frame in 2048 byte buffers, with headroom for the RSB and alignment pad
+ * that share the first buffer with the start of the frame.
+ */
+#define MAX_RX_BDS_PER_FRAME	8
+
+/* How long to keep polling for the DMA to finish a frame it has already
+ * announced. A 9000 byte frame takes ~72us on the wire at 1Gbps and ~7.2ms
+ * at 10Mbps; anything much longer than that means the frame never ends
+ * (or that the hardware never writes the descriptor word back, in which case
+ * only frames above RBUF_PKT_RDY_THLD get here, and are lost as before).
+ */
+#define RX_FRAME_WAIT_TIMEOUT	msecs_to_jiffies(20)
+
+#define DMA_RX_ERRORS		(DMA_RX_CRC_ERROR | DMA_RX_OV | DMA_RX_NO | \
+				 DMA_RX_LG | DMA_RX_RXER)
+
+static inline unsigned int bcmgenet_rx_next_ptr(struct bcmgenet_rx_ring *ring,
+						unsigned int ptr)
+{
+	return likely(ptr < ring->end_ptr) ? ptr + 1 : ring->cb_ptr;
+}
+
+/* Hand n descriptors back to the hardware */
+static void bcmgenet_rx_advance(struct bcmgenet_rx_ring *ring, unsigned int n)
+{
+	struct bcmgenet_priv *priv = ring->priv;
+
+	ring->c_index = (ring->c_index + n) & DMA_C_INDEX_MASK;
+	while (n--)
+		ring->read_ptr = bcmgenet_rx_next_ptr(ring, ring->read_ptr);
+	bcmgenet_rdma_ring_writel(priv, ring->index, ring->c_index,
+				  RDMA_CONS_INDEX);
+}
+
+/* Discard the buffers of the n descriptors at the read pointer, refilling
+ * them, and hand the descriptors back to the hardware.
+ */
+static void bcmgenet_rx_drop(struct bcmgenet_rx_ring *ring, unsigned int n)
+{
+	struct bcmgenet_priv *priv = ring->priv;
+	unsigned int ptr = ring->read_ptr;
+	struct sk_buff *skb;
+	unsigned int i;
+
+	for (i = 0; i < n; i++) {
+		skb = bcmgenet_rx_refill(priv, &priv->rx_cbs[ptr]);
+		if (skb)
+			dev_kfree_skb_any(skb);
+		ptr = bcmgenet_rx_next_ptr(ring, ptr);
+	}
+	bcmgenet_rx_advance(ring, n);
+}
+
+/* Outcome of looking at the descriptors of the frame at the read pointer */
+enum bcmgenet_rx_frame_state {
+	RX_FRAME_COMPLETE,	/* SOP..EOP all there: nbds descriptors */
+	RX_FRAME_PENDING,	/* the DMA is still writing it */
+	RX_FRAME_BROKEN,	/* drop nbds descriptors */
+};
+
+/* The descriptor status word of the buffer at the read pointer is still
+ * zero. Peek at the receive status block in that buffer without taking it
+ * off the ring: when the whole frame was in the RBUF before the DMA started
+ * on it, the RSB describes it completely (length and flags), and the
+ * descriptor words are not needed at all. This keeps frames up to
+ * RBUF_PKT_RDY_THLD flowing even if it turns out the hardware does not write
+ * the descriptor words back when the 64B RSB is enabled.
+ */
+static enum bcmgenet_rx_frame_state
+bcmgenet_rx_frame_from_rsb(struct bcmgenet_rx_ring *ring, unsigned int avail,
+			   u32 *bd_ls, unsigned int *nbds)
+{
+	struct bcmgenet_priv *priv = ring->priv;
+	struct device *kdev = &priv->pdev->dev;
+	struct enet_cb *cb = &priv->rx_cbs[ring->read_ptr];
+	dma_addr_t mapping = dma_unmap_addr(cb, dma_addr);
+	unsigned int total, len, n, i;
+	u32 ls;
+
+	*nbds = 0;
+	if (!cb->skb || !mapping)
+		return RX_FRAME_PENDING;
+
+	dma_sync_single_for_cpu(kdev, mapping, sizeof(struct status_64),
+				DMA_FROM_DEVICE);
+	ls = ((struct status_64 *)cb->skb->data)->length_status;
+	dma_sync_single_for_device(kdev, mapping, sizeof(struct status_64),
+				   DMA_FROM_DEVICE);
+
+	/* Nothing there yet, or the DMA started before the end of the frame
+	 * (no DMA_EOP): only the descriptor words can tell the real length.
+	 */
+	if ((ls & (DMA_SOP | DMA_EOP)) != (DMA_SOP | DMA_EOP))
+		return RX_FRAME_PENDING;
+
+	total = ls >> DMA_BUFLENGTH_SHIFT;
+	n = DIV_ROUND_UP(total, priv->rx_buf_len);
+	if (n > avail)
+		return RX_FRAME_PENDING;
+	*nbds = n;
+	if (n > MAX_RX_BDS_PER_FRAME)
+		return RX_FRAME_BROKEN;
+
+	for (i = 0; i < n; i++) {
+		len = min(total, priv->rx_buf_len);
+		total -= len;
+		bd_ls[i] = (len << DMA_BUFLENGTH_SHIFT) |
+			   (ls & 0xffff & ~(DMA_SOP | DMA_EOP));
+	}
+	bd_ls[0] |= DMA_SOP;
+	bd_ls[n - 1] |= DMA_EOP;
+	return RX_FRAME_COMPLETE;
+}
+
+/* Work out how many descriptors, starting at the read pointer, make up the
+ * next frame, and collect their length/status words.
+ *
+ * The 64 byte receive status block (RSB) at the start of the first buffer is
+ * written when the RDMA *starts* on a frame. For frames longer than
+ * RBUF_PKT_RDY_THLD that happens before the frame has been fully received,
+ * so the RSB carries a truncated length and no DMA_EOP, and the producer
+ * index may be bumped while the DMA is still writing. The descriptor's own
+ * length/status word is written when the DMA has finished with that buffer,
+ * so it is the one to trust. bcmgenet_rx_refill() clears it, so a zero
+ * means the DMA has not finished with the buffer yet.
+ *
+ * Frames longer than the Rx buffer are spread over consecutive descriptors:
+ * DMA_SOP on the first, DMA_EOP on the last, nothing on the ones in between.
+ * Only the first buffer has the RSB and the 2 byte alignment pad.
+ */
+static enum bcmgenet_rx_frame_state
+bcmgenet_rx_frame_bds(struct bcmgenet_rx_ring *ring, unsigned int avail,
+		      u32 *bd_ls, unsigned int *nbds)
+{
+	struct bcmgenet_priv *priv = ring->priv;
+	unsigned int ptr = ring->read_ptr;
+	unsigned int n = 0;
+	u32 ls;
+
+	while (n < avail && n < MAX_RX_BDS_PER_FRAME) {
+		ls = dmadesc_get_length_status(priv, priv->rx_cbs[ptr].bd_addr);
+		if (!ls) {
+			if (n == 0)
+				return bcmgenet_rx_frame_from_rsb(ring, avail,
+								  bd_ls, nbds);
+			break;
+		}
+
+		if (n == 0) {
+			/* A continuation without a start: the frame it
+			 * belonged to was dropped, drop this too.
+			 */
+			if (!(ls & DMA_SOP)) {
+				*nbds = 1;
+				return RX_FRAME_BROKEN;
+			}
+		} else if (ls & DMA_SOP) {
+			/* A new frame starts before the current one ended:
+			 * the current one was cut short, drop what we have.
+			 */
+			*nbds = n;
+			return RX_FRAME_BROKEN;
+		}
+
+		bd_ls[n++] = ls;
+		if (ls & DMA_EOP) {
+			*nbds = n;
+			return RX_FRAME_COMPLETE;
+		}
+		ptr = bcmgenet_rx_next_ptr(ring, ptr);
+	}
+
+	if (n == MAX_RX_BDS_PER_FRAME) {
+		/* Longer than anything we allowed, drop the head; the tail
+		 * will be dropped as headless continuations.
+		 */
+		*nbds = n;
+		return RX_FRAME_BROKEN;
+	}
+
+	*nbds = n;
+	return RX_FRAME_PENDING;
+}
