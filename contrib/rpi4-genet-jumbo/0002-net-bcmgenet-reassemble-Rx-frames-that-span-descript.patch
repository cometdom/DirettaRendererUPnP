 	}
 
@@ -2277,40 +2309,233 @@ static struct sk_buff *bcmgenet_rx_refill(struct bcmgenet_priv *priv,
 		dev_kfree_skb_any(skb);
 		netif_err(priv, rx_err, priv->dev,
 			  "%s: Rx skb DMA mapping failed\n", __func__);
+		bcmgenet_rx_reset_cb(priv, cb);
