+/* A buffer that stays on the ring because it could not be replaced must not
+ * look like it holds a finished frame the next time we come across it: clear
+ * the descriptor status word and the receive status block in the buffer.
+ */
+static void bcmgenet_rx_reset_cb(struct bcmgenet_priv *priv,
+				 struct enet_cb *cb)
+{
+	struct device *kdev = &priv->pdev->dev;
+	dma_addr_t mapping = dma_unmap_addr(cb, dma_addr);
+
+	dmadesc_set_length_status(priv, cb->bd_addr, 0);
+	if (cb->skb && mapping) {
+		dma_sync_single_for_cpu(kdev, mapping, sizeof(struct status_64),
+					DMA_FROM_DEVICE);
+		memset(cb->skb->data, 0, sizeof(struct status_64));
+		dma_sync_single_for_device(kdev, mapping,
+					   sizeof(struct status_64),
+					   DMA_FROM_DEVICE);
+	}
+}
